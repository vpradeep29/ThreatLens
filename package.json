{
  "name": "lvs-advanced-scanner",
  "version": "2.0.0",
  "description": "Advanced vulnerability scanner with Vite + FastAPI",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "backend:dev": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "backend:prod": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt"
  },
  "keywords": ["security", "vulnerability", "scanner", "vite", "fastapi"],
  "author": "",
  "license": "MIT",
  "devDependencies": {}
}
